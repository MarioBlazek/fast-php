#!/usr/bin/env php
<?php
declare(strict_types=1);

// Composer sets this for vendor/bin proxies; fall back to this checkout's vendor/.
$autoload = $GLOBALS['_composer_autoload_path'] ?? null;
foreach ([$autoload, __DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $file) {
    if ($file !== null && is_file($file)) {
        require $file;
        break;
    }
}

// Parsing a framework's few thousand files takes more than php.ini's usual 128M.
ini_set('memory_limit', '-1');

exit((new FastPhp\Cli\Application())->run());
